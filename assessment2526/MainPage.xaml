<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="assessment2526.MainPage"
                Title="Settings">


    <VerticalStackLayout  Padding="20" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start"
              Padding="10">
       
            <Label
              Grid.Column="0"
              FontSize="Subtitle"
              Text="Voice Assistance" 
             HorizontalOptions="Start"
             VerticalOptions="Start"
             SemanticProperties.HeadingLevel="Level2"
            />
            <Switch 
              Grid.Column="1"
              Toggled="text_speach_toggle"
              HorizontalOptions="End"
              VerticalOptions="Start"
              SemanticProperties.Description="Voice Assistance"
              SemanticProperties.Hint="Turns text-to-speech narration on or off across the app"/>

        </Grid>



    </VerticalStackLayout>



</ContentPage>
